# ─────────────────────────────────────────────
# Bank Game Platform – Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000

# ── Database (PostgreSQL) ──────────────────────
# Local Docker:
DATABASE_URL=postgresql://bgp:bgp_dev_secret@localhost:5432/bank_game_platform

# Railway / Neon / Supabase (paste connection string from dashboard):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Redis ──────────────────────────────────────
# Local Docker:
REDIS_URL=redis://localhost:6379

# Upstash (free tier – paste from console.upstash.com):
# REDIS_URL=rediss://default:xxxxxxxx@apn1-xxxxx.upstash.io:6379

# ── JWT Secrets (change in production!) ───────
JWT_ACCESS_SECRET=change_me_to_a_random_64_char_string_in_production_!!
JWT_REFRESH_SECRET=change_me_too_different_from_access_secret_64chars_!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────
# Frontend URLs (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Optional: Bank Core API ───────────────────
# BANK_CORE_API_URL=https://api.yourbank.com/v1
# BANK_CORE_API_KEY=your_api_key_here

# ── Optional: S3 / Object Storage ─────────────
# S3_BUCKET=bank-game-platform-assets
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
